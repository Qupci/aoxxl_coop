 	}
 }
 
+bool g_lateLoad = false;
+static WNDPROC g_latePrevProc = 0;
+
+// Late load: the window class is registered already, so the game window is
+// subclassed (chaining to whatever procedure it has, other mods included).
+LRESULT __stdcall LateWndProc(HWND hWnd, UINT uMsg, WPARAM wParam, LPARAM lParam)
+{
+	IGWndProc(hWnd, uMsg, wParam, lParam);
+	// Typing into a field: the keys are the Inspector's, not the game's.
+	extern bool IGWantsTextInput();
+	if (IGWantsTextInput() && (uMsg == WM_KEYDOWN || uMsg == WM_KEYUP || uMsg == WM_CHAR ||
+	                           uMsg == WM_SYSKEYDOWN || uMsg == WM_SYSKEYUP))
+		return 0;
+	return CallWindowProcA(g_latePrevProc, hWnd, uMsg, wParam, lParam);
+}
+
+void LateSubclass(HWND hwnd)
+{
+	if (g_lateLoad && hwnd && !g_latePrevProc)
+		g_latePrevProc = (WNDPROC)SetWindowLongPtrA(hwnd, GWLP_WNDPROC, (LONG_PTR)LateWndProc);
+}
