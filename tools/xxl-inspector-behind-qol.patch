+// True while an ImGui text field (or a drag field being typed into) has the
+// keyboard. Other mods ask for it (exported: the XXL co-op mod reads the
+// keyboard for player 2 and must not see the typing).
+bool IGWantsTextInput()
+{
+	return ImGui::GetCurrentContext() && ImGui::GetIO().WantTextInput;
+}
+
+extern "C" __declspec(dllexport) int __cdecl XXLInspectorWantsKeyboard()
+{
+	return IGWantsTextInput() ? 1 : 0;
+}
+
 LRESULT __stdcall IGWndProc(HWND hWnd, UINT uMsg, WPARAM wParam, LPARAM lParam)
 {
+	// Messages can arrive before the D3D device (and with it ImGui) exists, e.g.
+	// when loaded as apd3d9.dll behind the XXL QoL patch.
+	if (!ImGui::GetCurrentContext()) return 0;
 	return ImGui_ImplWin32_WndProcHandler(hWnd, uMsg, wParam, lParam);
 }
diff --git a/main.cpp b/main.cpp
