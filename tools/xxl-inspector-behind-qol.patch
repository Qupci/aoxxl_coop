+void LateStart()
+{
+	static bool started = false;
+	if (started) return;
+	started = true;
+	SetMemProtection((void*)(0x401000 + exeRebase), PAGE_EXECUTE_READWRITE);
+	VerifyVersion();
+	ReadSettings();
+	PatchStart_XXL();
+	// .text stays writable: other mods patch it after us.
+}
